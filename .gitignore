# Secrets — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# OS
.DS_Store

# Verifier Tier-1 dedup state (runtime)
verifier_seen_inputs.json

# runtime logs
*.log

# per-attempt generation trace (runtime, written next to each output file)
*_attempts.jsonl

# generation stop sentinel (runtime)
STOP_GEN

# Runtime outputs (accepted questions and coverage in outputs/ are kept as samples)
outputs/verifier_seen_inputs.json

# Temp files from atomic writes (left behind only if a write is interrupted)
*.tmp

# Run and calibration logs and the attempt log in outputs/ are kept (2026-11-19, the author): they are the evidence
# behind the reported yield, A/B and calibration numbers. Account IDs are masked before they are committed.
!outputs/*.log
!outputs/**/*.log
!outputs/*_attempts.jsonl

# official JEE question papers (downloaded, large): kept locally, not in git
data/raw_papers/
