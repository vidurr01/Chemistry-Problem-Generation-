# Copy to .env (gitignored) and fill in. Every script loads .env from the repo root.

# Required: all roles in run_groundup_final.py, the verifier, and calibration scripts.
OPENROUTER_KEY=your-openrouter-key-here

# Optional: SambaNova keys, for run_graph_final.py (up to _5, rotated on rate limits),
# calibration/calibrate_thresholds*.py, calibration/calibrate_solver_metatags*.py (up to _4)
# and tools/extract_notes.py. run_graph_final.py and calibrate_thresholds*.py also need a
# local Ollama server with llama3.2 (`ollama pull llama3.2`) at http://localhost:11434.
# SAMBANOVA_KEY_1=
# SAMBANOVA_KEY_2=

# Optional: JEE Mains data for calibration/council_eval.py --set mains.
# JEE_MAINS_FILE=
